# Companies House public data API key; without it Companies House results are "check manually".
COMPANIES_HOUSE_API_KEY=
# Signs OAuth tokens and client IDs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The one Google account allowed to sign in. Unset means nobody can.
ALLOWED_EMAIL=
# Google OAuth web client, with redirect URI <PUBLIC_BASE_URL>/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the server, e.g. https://dibs.interstellarai.net
PUBLIC_BASE_URL=
# Port for dibs-http (optional, default 8000).
PORT=
